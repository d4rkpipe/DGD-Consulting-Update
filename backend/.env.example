# Django
SECRET_KEY=django-insecure-CHANGE-ME-IN-PRODUCTION
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave empty for SQLite, or use postgres URL for production
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=

# CORS — frontend domains allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=dgdconsulting2023@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here
DEFAULT_FROM_EMAIL=DGD Consulting <dgdconsulting2023@gmail.com>
ADMIN_EMAIL=dgdconsulting2023@gmail.com
